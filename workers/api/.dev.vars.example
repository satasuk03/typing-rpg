# Copy to .dev.vars (git-ignored) for `wrangler dev`. NEVER commit real secrets.
# Production: `wrangler secret put JWT_SECRET` / `wrangler secret put TICKET_SECRET` (>= 32 random bytes each).
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
TICKET_SECRET=dev-only-ticket-secret-change-me-0123456789abcdef
